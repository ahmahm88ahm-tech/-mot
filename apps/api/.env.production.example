# ═══ متغيرات إنتاج الـ Backend ═══  (انسخه إلى .env.production)
# ⚠️ قيَم إنتاجية حقيقية — لا تستخدم قيم التطوير
DATABASE_URL=postgresql://USER:PASS@HOST:5432/motanaqil?schema=public&connection_limit=15

# مفاتيح قوية (ولّدها: openssl rand -base64 48)
JWT_SECRET=
MFA_ENCRYPTION_KEY=

PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://motanaqil.com,https://www.motanaqil.com

# التخزين (S3/MinIO إنتاجي)
S3_ENDPOINT=
S3_REGION=me-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=motanaqil-uploads

# البريد الإنتاجي
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@motanaqil.com

# ═══ مؤجَّل — اتركها فارغة حتى مسار ج ═══
SENDGRID_API_KEY=
UNIFONIC_APP_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
ZATCA_VAT_NUMBER=
